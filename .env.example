# Copy to .env and adjust. Loaded by backend/config.py (pydantic-settings).

# SQLite for the prototype. Swap for postgres URL later if you want.
DATABASE_URL=sqlite:///./portfolio.db

# Base URL the Streamlit frontend uses to reach the FastAPI backend.
API_BASE_URL=http://127.0.0.1:8000

# Optional: fallback annual risk-free rates (decimals) if live fetch fails.
# NASDAQ / US ~ 10Y Treasury; NSE / India ~ 10Y G-Sec.
RFR_US_FALLBACK=0.043
RFR_INDIA_FALLBACK=0.070
